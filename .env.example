# -- Base de datos (Firebase / Firestore) ------------------------------------
# Elegi UNA de estas dos formas de autenticarte. Nunca commitees el archivo
# JSON de la cuenta de servicio -- por eso *.json de credenciales esta en
# .gitignore. Si dejas ambas vacias, la app usa un backend en memoria
# (datos se borran al reiniciar) -- util para probar sin credenciales.
#
# Opcion A (recomendada para Vercel/prod): pegar el JSON completo de la
# cuenta de servicio como una sola linea en esta variable.
#   Como conseguirlo: Firebase Console -> Configuracion del proyecto ->
#   Cuentas de servicio -> Generar nueva clave privada (descarga un .json).
#   Despues: python -c "import json;print(json.dumps(json.load(open('archivo.json'))))"
#   y pegas el resultado ahi abajo.
FIREBASE_CREDENTIALS_JSON=

# Opcion B (comoda para dev local): guardar el .json en el disco (fuera del
# repo, o con el nombre que aparece en .gitignore) y apuntar aca la ruta.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/a/tu-serviceAccountKey.json

# Solo necesario si no seteaste ninguna credencial arriba pero SI queres
# forzar el project id (por ejemplo corriendo con Application Default
# Credentials en una VM de GCP).
FIREBASE_PROJECT_ID=

# -- Sesiones ------------------------------------------------------------------
# Clave para firmar las cookies de sesion (stateless). OBLIGATORIA en prod:
# si no la seteas, cada reinicio del servidor invalida todas las sesiones.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia_esto_por_algo_random_y_largo

# -- Admins iniciales (opcional, seed_admin() los crea automatico) ---------
# ADMIN_PASSWORD=admin123      # tienda 929, username=admin
# ADMIN96_PASSWORD=admin96     # tienda 96,  username=admin96

# -- SMTP para recuperacion de contrasena ----------------------------------
# Opcion A: Gmail con App Password
#   1. Activa 2FA en tu cuenta Google
#   2. Ve a myaccount.google.com/apppasswords
#   3. Crea una App Password para "Mail"
#   4. Pega el codigo de 16 letras en SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# URL publica de la app (para los links de recuperacion de contrasena).
# Actualizala con tu dominio de Vercel una vez desplegado.
APP_URL=https://tu-proyecto.vercel.app

# -- Cron de limpieza de fotos ------------------------------------------------
# Vercel Cron pega diario a las 22:00 hora Chile (01:00 UTC, ver vercel.json)
# a /cron/clear-photos para borrar las fotos (image_data/image_mime) de los
# items activos. Setea esta misma clave como env var "CRON_SECRET" en Vercel:
# Vercel agrega automaticamente el header "Authorization: Bearer <valor>"
# a cada invocacion de cron cuando esta env var existe, y el endpoint la
# valida. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=cambia_esto_tambien_por_algo_random
