# ── Base de datos (Supabase Postgres) ─────────────────────────────────────
# Copialo desde Supabase → Project Settings → Database → Connection string
# (usa el modo "Transaction pooler" si vas a correr en serverless/Vercel).
# Si se deja vacío, la app usa SQLite local (./pickerhunt.db) automáticamente
# — útil para desarrollo rápido sin depender de internet.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_PROYECTO.supabase.co:5432/postgres

# ── Sesiones ───────────────────────────────────────────────────────────────
# Clave para firmar las cookies de sesión (stateless). OBLIGATORIA en prod:
# si no la seteas, cada reinicio del servidor invalida todas las sesiones.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia_esto_por_algo_random_y_largo

# ── Admins iniciales (opcional, seed_admin() los crea automático) ─────────
# ADMIN_PASSWORD=admin123      # tienda 929, username=admin
# ADMIN96_PASSWORD=admin96     # tienda 96,  username=admin96

# ── SMTP para recuperación de contraseña ──────────────────────────────────
# Opción A: Gmail con App Password
#   1. Activa 2FA en tu cuenta Google
#   2. Ve a myaccount.google.com/apppasswords
#   3. Crea una App Password para "Mail"
#   4. Pega el código de 16 letras en SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# URL pública de la app (para los links de recuperación de contraseña).
# Actualízala con tu dominio de Vercel una vez desplegado.
APP_URL=https://tu-proyecto.vercel.app
