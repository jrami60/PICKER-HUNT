# ── Base de datos (Neon Postgres) ─────────────────────────────────────────
# Copialo desde Neon → tu proyecto → Connection Details → Connection string.
# Si vas a correr en serverless/Vercel, usa el host "pooled" (con sufijo
# "-pooler" en el hostname) para no agotar el límite de conexiones directas.
# Neon exige TLS: la URL que te dan ya trae "?sslmode=require"; si la pegás
# sin eso, database.py lo agrega solo.
# Si se deja vacío, la app usa SQLite local (./pickerhunt.db) automáticamente
# — útil para desarrollo rápido sin depender de internet.
DATABASE_URL=postgresql://usuario:TU_PASSWORD@ep-tu-proyecto-pooler.us-east-2.aws.neon.tech/pickerhunt?sslmode=require

# ── Sesiones ───────────────────────────────────────────────────────────────
# Clave para firmar las cookies de sesión (stateless). OBLIGATORIA en prod:
# si no la seteas, cada reinicio del servidor invalida todas las sesiones.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia_esto_por_algo_random_y_largo

# ── Admins iniciales (opcional, seed_admin() los crea automático) ─────────
# ADMIN_PASSWORD=admin123      # tienda 929, username=admin
# ADMIN96_PASSWORD=admin96     # tienda 96,  username=admin96

# ── SMTP para recuperación de contraseña ──────────────────────────────────
# Opción A: Gmail con App Password
#   1. Activa 2FA en tu cuenta Google
#   2. Ve a myaccount.google.com/apppasswords
#   3. Crea una App Password para "Mail"
#   4. Pega el código de 16 letras en SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# URL pública de la app (para los links de recuperación de contraseña).
# Actualízala con tu dominio de Vercel una vez desplegado.
APP_URL=https://tu-proyecto.vercel.app

# ── Cron de limpieza de fotos ──────────────────────────────────────────────
# Vercel Cron pega diario a las 22:00 hora Chile (01:00 UTC, ver vercel.json)
# a /cron/clear-photos para borrar las fotos (image_data/image_mime) de los
# items activos. Seteá esta misma clave como env var "CRON_SECRET" en Vercel:
# Vercel agrega automáticamente el header "Authorization: Bearer <valor>"
# a cada invocación de cron cuando esta env var existe, y el endpoint la
# valida. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=cambia_esto_tambien_por_algo_random
